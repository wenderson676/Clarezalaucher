<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude local unencrypted SQLite financial database from unauthenticated cloud backups -->
        <include domain="sharedpref" path="."/>
        <exclude domain="database" path="vidasimples_database"/>
        <exclude domain="database" path="vidasimples_database-wal"/>
        <exclude domain="database" path="vidasimples_database-shm"/>
    </cloud-backup>
    <device-transfer>
        <!-- Allow encrypted device-to-device migration between user's devices -->
        <include domain="sharedpref" path="."/>
        <include domain="database" path="vidasimples_database"/>
        <include domain="database" path="vidasimples_database-wal"/>
        <include domain="database" path="vidasimples_database-shm"/>
    </device-transfer>
</data-extraction-rules>
